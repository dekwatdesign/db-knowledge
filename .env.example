# การเชื่อมต่อ MySQL ใช้บัญชีอ่านอย่างเดียวและให้สิทธิ์เท่าที่จำเป็น
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=readonly_user
DB_PASSWORD=replace_me

# การสร้าง Markdown
OUTPUT_DIR=generated
SAMPLE_ROWS=8
# จำกัดข้อความต่อช่องก่อนรับ sample; binary แสดงเฉพาะขนาด ไม่ดึงเนื้อหา
SAMPLE_MAX_CHARS=1000

# API Service: เลือก protocol ไม่ผูกกับค่าย (ollama, openai, anthropic, gemini)
AI_API_TYPE=ollama
# Base URL ไม่รวม endpoint; openai ต้องรวม version prefix เช่น /v1
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
AI_TIMEOUT_SECONDS=180
# ใช้กับ ollama, anthropic, gemini; openai ใช้ค่าเริ่มต้นของ service/model
AI_MAX_OUTPUT_TOKENS=4096
# เปิดได้เมื่ออนุมัติให้ส่ง metadata ไปยังปลายทางนอกเครื่องแล้วเท่านั้น
AI_ALLOW_REMOTE=false

# config เดิม OLLAMA_HOST, OLLAMA_MODEL, OLLAMA_TIMEOUT_SECONDS ยังใช้ได้
# เมื่อไม่กำหนด AI_* ที่เทียบเท่า (AI_API_TYPE ค่าเริ่มต้นคือ ollama)
